# ── Database ────────────────────────────────────────────────
# PostgreSQL runs inside Docker — no local install needed
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Used by FastAPI (Python) to connect to Postgres via Docker
DATABASE_URL=
# Used by Drizzle ORM (TypeScript) for migrations
DRIZZLE_DATABASE_URL=

# ── JWT Auth ─────────────────────────────────────────────────
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=
REFRESH_TOKEN_EXPIRE_DAYS=

# ── Next.js Public Env ───────────────────────────────────────
# These are exposed to the browser (NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_WS_URL=ws://localhost:8001

# ── upstash Rate Limiting (optional for local dev) ───────────
# Get free credentials at: https://upstash.com
# Leave empty to skip edge rate limiting in local development
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Agno AI Agent (optional stretch goal) ────────────────────
# Required only if using the @ai mention feature
OPENAI_API_KEY=
AGNO_MODEL=gpt-4o-mini
